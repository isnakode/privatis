---
// src/layouts/MainLayout.astro
import "../styles/global.css";
const { title = "TechPrivat | Premium 1-on-1 Tech Tutoring Indonesia" } =
  Astro.props;

import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";

import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/500.css";
import { MenuIcon } from "@lucide/astro";

const waLink =
  "https://wa.me/6287874491453?text=Halo%20Kak%2C%20saya%20mau%20konsultasi%20tentang%20program%20tutoring%20privatnya%20nih.%20Boleh%20dibantu%20informasi%20detailnya%3F%20Terima%20kasih";
const ogImageUrl = new URL("/og_image.png", Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html class="light" lang="id">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta
      name="description"
      content="Belajar coding intensif 1-on-1 langsung dari praktisi berpengalaman. Materi custom dan ramah pemula"
    />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta
      property="og:title"
      content="Privat Coding 1-on-1 Terbaik | PrivatIs"
    />
    <meta
      property="og:description"
      content="Belajar coding intensif langsung dari praktisi. Bangun portfolio idemu dari hari pertama."
    />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      property="twitter:title"
      content="Privat Coding 1-on-1 Terbaik | PrivatIs"
    />
    <meta
      property="twitter:description"
      content="Belajar coding intensif langsung dari praktisi. Bangun portfolio idemu dari hari pertama."
    />
    <meta property="twitter:image" content={ogImageUrl} />
    <title>{title}</title>

    <style is:global>
      body {
        background-color: #f8faff;
        color: #0f172a;
        scroll-behavior: smooth;
      }
      .text-gradient {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(59, 130, 246, 0.1);
      }
      .hero-blob {
        filter: blur(80px);
        z-index: -1;
      }
      .floating {
        animation: floating 6s ease-in-out infinite;
      }
      @keyframes floating {
        0% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-20px);
        }
        100% {
          transform: translateY(0px);
        }
      }
      .stagger-item:nth-child(even) {
        transform: translateY(30px);
      }
      .track-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -15px rgba(59, 130, 246, 0.15);
      }
    </style>
  </head>
  <body class="font-body antialiased overflow-x-hidden">
    <!-- Navigasi -->
    <nav
      class="fixed top-0 w-full z-50 bg-white/60 backdrop-blur-md border-b border-slate-100"
    >
      <div
        class="flex justify-between items-center px-6 py-4 max-w-7xl mx-auto"
      >
        <!-- LOGO -->
        <div class="text-2xl font-extrabold tracking-tight text-zinc-800">
          Privat<span class="text-blue-500">Is</span>
        </div>

        <!-- NAV DESKTOP (Hidden di HP) -->
        <div class="hidden md:flex items-center space-x-10">
          <a
            class="text-slate-600 hover:text-blue-500 font-medium transition-colors"
            href="#program">Program</a
          >
          <a
            class="text-slate-600 hover:text-blue-500 font-medium transition-colors"
            href="#fasilitas">Fasilitas</a
          >
          <a
            class="text-slate-600 hover:text-blue-500 font-medium transition-colors"
            href="#kenapa">Kenapa Kami</a
          >
          <a href={waLink} target="_blank" class="btn cursor-pointer"
            >Konsultasi Gratis</a
          >
        </div>

        <!-- TOMBOL HAMBURGER (Hanya muncul di HP) -->
        <button
          id="menu-btn"
          aria-label="menu"
          class="md:hidden text-blue-500 p-2 cursor-pointer focus:outline-none z-50"
        >
          <MenuIcon id="menu-icon" />
        </button>
      </div>

      <!-- NAV MOBILE (Awalnya tersembunyi di atas layar: -translate-y-full) -->
      <div
        id="mobile-menu"
        class="fixed inset-x-0 top-0 bg-white border-b border-slate-100 p-6 pt-24 shadow-xl transform -translate-y-full transition-transform duration-300 ease-in-out md:hidden -z-10"
      >
        <div class="flex flex-col space-y-6 text-center">
          <a
            class="mobile-link text-lg text-slate-600 hover:text-blue-500 font-medium transition-colors py-2"
            href="#program">Program</a
          >
          <a
            class="mobile-link text-lg text-slate-600 hover:text-blue-500 font-medium transition-colors py-2"
            href="#fasilitas">Fasilitas</a
          >
          <a
            class="mobile-link text-lg text-slate-600 hover:text-blue-500 font-medium transition-colors py-2"
            href="#kenapa">Kenapa Kami</a
          >
          <a
            href={waLink}
            target="_blank"
            class="btn cursor-pointer w-full inline-block py-3"
            >Konsultasi Gratis</a
          >
        </div>
      </div>
    </nav>

    <!-- Tempat Konten Utama Masuk -->
    <slot />

    <footer class="bg-white border-t border-slate-100 py-16">
      <div class="max-w-7xl mx-auto px-6">
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-12"
        >
          <div>
            <div class="text-2xl font-extrabold tracking-tight text-zinc-800">
              Privat<span class="text-blue-500">Is</span>
            </div>
            <p class="text-slate-400 text-sm">
              © 2026 Privatis Tutoring. <br />All rights reserved.
            </p>
          </div>
          <div
            class="flex flex-wrap justify-center gap-8 text-sm font-semibold text-slate-500"
          >
            <a
              target="_blank"
              class="hover:text-blue-500 transition-colors"
              href="https://instagram.com/aroftu.isnaini">Instagram</a
            >
            <a
              target="_blank"
              class="hover:text-blue-500 transition-colors"
              href="https://youtube.com/@aroftu">Youtube</a
            >
            <a
              target="_blank"
              class="hover:text-blue-500 transition-colors"
              href="https://github.com/isnakode">Github</a
            >
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Reveal animations on scroll (Otomatis dibundel oleh Astro tanpa CDN)
      const observerOptions = { threshold: 0.1 };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("opacity-100", "translate-y-0");
            entry.target.classList.remove("opacity-0", "translate-y-10");
          }
        });
      }, observerOptions);

      document
        .querySelectorAll(".track-card, .relative.group")
        .forEach((el) => {
          el.classList.add(
            "opacity-0",
            "translate-y-10",
            "transition-all",
            "duration-1000",
          );
          observer.observe(el);
        });
    </script>
    <script>
      // Menggunakan fungsi standar Astro / Vanilla JS agar aman saat pindah halaman
      const menuBtn = document.getElementById("menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const mobileLinks = document.querySelectorAll(".mobile-link");

      if (menuBtn && mobileMenu) {
        // Fungsi Toggle Buka / Tutup
        menuBtn.addEventListener("click", () => {
          const isOpen = mobileMenu.classList.contains("translate-y-0");

          if (isOpen) {
            // Tutup Menu
            mobileMenu.classList.remove("translate-y-0");
            mobileMenu.classList.add("-translate-y-full");
          } else {
            // Buka Menu
            mobileMenu.classList.remove("-translate-y-full");
            mobileMenu.classList.add("translate-y-0");
          }
        });

        // Otomatis tutup menu kalau salah satu link menu diklik (biar pindah section mulus)
        mobileLinks.forEach((link) => {
          link.addEventListener("click", () => {
            mobileMenu.classList.remove("translate-y-0");
            mobileMenu.classList.add("-translate-y-full");
          });
        });
      }
    </script>
  </body>
</html>
