---
// src/pages/index.astro
import MainLayout from "../layouts/MainLayout.astro";
import TrackCard from "../components/TrackCard.astro";
import Img1 from "../assets/img1.webp";
import Img2 from "../assets/img2.webp";
import Img3 from "../assets/img3.webp";
import Img4 from "../assets/img4.webp";
import cafe from "../assets/cafe.webp";
import { Image } from "astro:assets";
import {
	MessageSquareMoreIcon,
	MehIcon,
	SpeechIcon,
	CalendarOffIcon,
	PanelsTopLeftIcon,
	SmartphoneIcon,
	CpuIcon,
	HouseIcon,
	CoffeeIcon,
	WifiIcon,
	TargetIcon,
	ShieldUserIcon,
	PresentationIcon,
	CodeIcon,
	LightbulbIcon,
} from "@lucide/astro";
const waLink =
	"https://wa.me/6287874491453?text=Halo%20Kak%2C%20saya%20mau%20konsultasi%20tentang%20program%20tutoring%20privatnya%20nih.%20Boleh%20dibantu%20informasi%20detailnya%3F%20Terima%20kasih";

// Data track untuk dilooping
const tracks = [
	{
		icon: CodeIcon,
		title: "Web Dev",
		skills: ["HTML/CSS", "JavaScript", "Wordpress"],
		colorClass: "text-blue-500",
		bgClass: "bg-blue-50",
	},
	{
		icon: SmartphoneIcon,
		title: "Mobile Dev",
		skills: ["Flutter", "React Native"],
		colorClass: "text-indigo-500",
		bgClass: "bg-indigo-50",
	},
	{
		icon: CpuIcon,
		title: "Embedded & IoT",
		skills: ["Arduino & ESP32", "Sensors & API"],
		colorClass: "text-sky-500",
		bgClass: "bg-sky-50",
	},
];
---

<MainLayout title="Tech Privat Lombok | Premium 1-on-1 Tech Tutoring Indonesia">
	<main>
		<!-- Hero Section -->
		<section
			class="relative pt-32 pb-24 md:pt-36 md:pb-40 px-6 overflow-hidden"
		>
			<div
				class="absolute top-20 -left-20 w-96 h-96 bg-blue-200/40 rounded-full hero-blob"
			>
			</div>
			<div
				class="absolute bottom-0 -right-20 w-125 h-125 bg-indigo-100/50 rounded-full hero-blob"
			>
			</div>
			<div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-16 items-center">
				<div class="relative z-10 text-center lg:text-left">
					<div
						class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full bg-blue-500/5 border border-blue-500/10 text-blue-500 font-bold text-xs tracking-widest uppercase"
					>
						<span
							class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"
						></span>
						Premium 1-on-1 Learning
					</div>
					<h1
						class="text-4xl md:text-6xl font-extrabold leading-[1.1] mb-6 text-slate-900"
					>
						Kuasai Tech Skill Masa Depan, <br />
						<span class="text-gradient"
							>1-on-1 Tanpa Antre Pertanyaan.</span
						>
					</h1>
					<p
						class="text-xl text-slate-500 mb-8 max-w-2xl leading-relaxed mx-auto lg:mx-0"
					>
						Privat pemrograman & IoT premium. Mentor fokus penuh
						100% ke kamu, materi bisa custom sesuai goals-mu, dan
						bebas pilih lokasi (Online, Rumah, atau pilihanmu
						sendiri).
					</p>
					<div
						class="flex flex-col sm:flex-row gap-5 justify-center lg:justify-start"
					>
						<a
							href={waLink}
							target="_blank"
							class="btn text-white cursor-pointer py-4 bg-blue-500 flex items-center justify-center gap-2"
						>
							<MessageSquareMoreIcon /> Hubungi Mentor via WA
						</a>
					</div>
				</div>

				<!-- Creative Code Card -->
				<div class="relative hidden lg:block floating">
					<div
						class="glass-card p-1 rounded-2xl shadow-2xl overflow-hidden border-slate-200/50"
					>
						<div class="bg-slate-900 rounded-xl p-8">
							<div class="flex items-center gap-2 mb-8">
								<div class="flex gap-1.5">
									<div
										class="w-3 h-3 rounded-full bg-red-500/80"
									>
									</div>
									<div
										class="w-3 h-3 rounded-full bg-amber-500/80"
									>
									</div>
									<div
										class="w-3 h-3 rounded-full bg-emerald-500/80"
									>
									</div>
								</div>
								<div
									class="ml-4 text-slate-500 font-code text-xs"
								>
									tech_privat_v2.py
								</div>
							</div>
							<pre
								class="font-code text-sm leading-relaxed text-slate-300"><span class="text-blue-400">class</span> <span class="text-emerald-400">PersonalMentor</span>:
    <span class="text-blue-400">def</span> <span class="text-emerald-400">__init__</span>(self):
        self.focus = <span class="text-orange-400">1.0</span> <span class="text-slate-500"># 100% attention</span>
        self.curriculum = <span class="text-orange-400">"Customized"</span>

    <span class="text-blue-400">def</span> <span class="text-emerald-400">start_session</span>(self, student):
        <span class="text-blue-400">while</span> student.has_questions:
            mentor.explain_until_clear()
            mentor.code_review(live=<span class="text-blue-400">True</span>)

<span class="text-slate-500"># Start your journey</span>
you = Student(<span class="text-orange-400">"Success"</span>)
mentor = PersonalMentor()
mentor.start_session(you)</pre>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Pain Point Section -->
		<section class="py-24 bg-white overflow-hidden">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid lg:grid-cols-2 gap-20 items-center">
					<div>
						<h2
							class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight mb-8"
						>
							Sering Gini Gak Sih Pas Belajar Coding?
						</h2>
						<p class="text-lg text-slate-500 leading-relaxed mb-12">
							Kami paham betul frustrasinya belajar teknologi
							sendirian atau di kelas yang terlalu ramai. Kamu
							butuh solusi yang lebih personal.
						</p>
						<div class="space-y-6">
							<div
								class="flex gap-6 items-start p-6 rounded-2xl hover:bg-slate-50 transition-colors"
							>
								<div
									class="w-14 h-14 shrink-0 rounded-2xl bg-red-50 flex items-center justify-center text-red-500"
								>
									<MehIcon />
								</div>

								<div>
									<h4
										class="text-xl font-bold text-slate-800 mb-2"
									>
										Stuck Belajar Otodidak
									</h4>
									<p class="text-slate-500 leading-relaxed">
										Nonton YouTube malah makin pusing karena
										gak ada tempat nanya pas ada error.
									</p>
								</div>
							</div>
							<div
								class="flex gap-6 items-start p-6 rounded-2xl hover:bg-slate-50 transition-colors"
							>
								<div
									class="w-14 h-14 shrink-0 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-500"
								>
									<SpeechIcon />
								</div>
								<div>
									<h4
										class="text-xl font-bold text-slate-800 mb-2"
									>
										Kelas Terlalu Ramai
									</h4>
									<p class="text-slate-500 leading-relaxed">
										Mau nanya tapi sungkan, atau
										pertanyaanmu terlewat karena mentor
										sibuk ngurusin puluhan orang.
									</p>
								</div>
							</div>
							<div
								class="flex gap-6 items-start p-6 rounded-2xl hover:bg-slate-50 transition-colors"
							>
								<div
									class="w-14 h-14 shrink-0 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-500"
								>
									<CalendarOffIcon />
								</div>
								<div>
									<h4
										class="text-xl font-bold text-slate-800 mb-2"
									>
										Waktu Gak Fleksibel
									</h4>
									<p class="text-slate-500 leading-relaxed">
										Jadwal kerja/kuliah padat, susah buat
										ikut kelas dengan jadwal kaku yang sudah
										ditentukan.
									</p>
								</div>
							</div>
						</div>
					</div>
					<div class="relative">
						<Image
							alt="Mentor session"
							class="rounded-3xl shadow-2xl w-full aspect-4/5 object-cover"
							src={cafe}
						/>
						<div
							class="absolute -top-10 -right-10 w-40 h-40 bg-blue-500/10 rounded-full hero-blob"
						>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Track Belajar -->
		<section class="py-32 relative overflow-hidden" id="program">
			<div class="absolute inset-0 bg-slate-50/50 -z-10">
				<div
					class="absolute inset-0 opacity-[0.03]"
					style="background-image: radial-gradient(#3B82F6 1px, transparent 1px); background-size: 24px 24px;"
				>
				</div>
			</div>
			<div class="max-w-7xl mx-auto px-6">
				<div
					class="flex flex-col lg:flex-row justify-between items-end mb-20 gap-8"
				>
					<div class="max-w-2xl">
						<h2
							class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight"
						>
							Pilih Focus Track Kamu
						</h2>
						<p class="text-xl text-slate-500 leading-relaxed">
							Dari nol sampai siap bikin project sendiri. Pilih
							kurikulum yang paling kamu butuhin, atau buat
							kurikulummu sendiri.
						</p>
					</div>
					<div
						class="hidden lg:block h-px bg-slate-200 grow mx-12 mb-6"
					>
					</div>
				</div>

				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
					<!-- Looping Komponen Kartu Pakai Array -->
					{tracks.map((track) => <TrackCard {...track} />)}

					<!-- Custom Track Card (Desain Khusus Warna Biru) -->
					<div
						class="track-card bg-blue-500 p-8 rounded-3xl transition-all duration-500 flex flex-col group shadow-xl shadow-blue-500/20"
					>
						<div
							class="w-16 h-16 rounded-2xl bg-white/20 text-white flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
						>
							<LightbulbIcon />
						</div>
						<h3 class="text-2xl font-bold text-white mb-4">
							Punya Permintaan Khusus?
						</h3>
						<p
							class="text-white/80 text-sm leading-relaxed mb-8 grow"
						>
							Belum menemukan teknologi yang ingin kamu pelajari?
							Kami carikan mentor yang tepat.
						</p>
						<a
							href={waLink}
							target="_blank"
							class="w-full py-4 cursor-pointer bg-white text-blue-500 rounded-xl font-bold text-sm hover:bg-slate-50 transition-colors flex items-center justify-center gap-2"
						>
							Konsultasi Materi
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Flexibility section -->
		<section class="py-32 px-6 overflow-hidden" id="fasilitas">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-24">
					<h2
						class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6"
					>
						Belajar Lebih Fleksibel
					</h2>
					<p class="text-xl text-slate-500 max-w-2xl mx-auto">
						Tentukan tempat belajar yang paling membuatmu nyaman dan
						produktif.
					</p>
				</div>
				<div
					class="grid lg:grid-cols-3 gap-12 items-stretch max-w-7xl mx-auto px-4 py-16"
				>
					<div
						class="relative group bg-white border border-slate-100 p-8 rounded-3xl shadow-sm hover:shadow-xl hover:border-blue-500/20 transition-all duration-500 transform hover:-translate-y-2 min-h-60 flex flex-col justify-between"
					>
						<div
							class="absolute inset-0 bg-linear-to-br from-blue-50/0 to-blue-50/30 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"
						>
						</div>

						<div>
							<div
								class="w-12 h-12 bg-linear-to-br bg-blue-500 text-white rounded-2xl flex items-center justify-center mb-5 shadow-md shadow-blue-500/20 transform group-hover:scale-110 group-hover:rotate-3 transition-all duration-300"
							>
								<HouseIcon />
							</div>

							<h4
								class="text-2xl font-bold text-slate-900 mb-3 tracking-tight group-hover:text-blue-600 transition-colors"
							>
								Mentor Ke Rumah
							</h4>
							<p class="text-slate-500 text-sm leading-relaxed">
								Fokus belajar di kenyamanan rumahmu sendiri.
								Mentor terbaik kami yang langsung jemput bola ke
								tempatmu.
							</p>
						</div>
					</div>

					<div
						class="relative group bg-white border border-slate-100 p-8 rounded-3xl shadow-sm hover:shadow-xl hover:border-amber-500/20 transition-all duration-500 transform hover:-translate-y-2 lg:mt-12 min-h-60 flex flex-col justify-between"
					>
						<div
							class="absolute inset-0 bg-linear-to-br from-amber-50/0 to-amber-50/30 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"
						>
						</div>

						<div>
							<div
								class="w-12 h-12 bg-linear-to-br bg-amber-500 text-white rounded-2xl flex items-center justify-center mb-5 shadow-md shadow-amber-500/20 transform group-hover:scale-110 group-hover:rotate-3 transition-all duration-300"
							>
								<CoffeeIcon />
							</div>

							<h4
								class="text-2xl font-bold text-slate-900 mb-3 tracking-tight group-hover:text-amber-600 transition-colors"
							>
								Cafe / Coworking
							</h4>
							<p class="text-slate-500 text-sm leading-relaxed">
								Suasana baru biar makin produktif. Pilih cafe
								ternyaman atau coworking space favorit yang ada
								di kotamu.
							</p>
						</div>
					</div>

					<div
						class="relative group bg-white border border-slate-100 p-8 rounded-3xl shadow-sm hover:shadow-xl hover:border-emerald-500/20 transition-all duration-500 transform hover:-translate-y-2 min-h-60 flex flex-col justify-between"
					>
						<div
							class="absolute inset-0 bg-linear-to-br from-emerald-50/0 to-emerald-50/30 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"
						>
						</div>

						<div>
							<div
								class="w-12 h-12 bg-linear-to-br bg-emerald-500 text-white rounded-2xl flex items-center justify-center mb-5 shadow-md shadow-emerald-500/20 transform group-hover:scale-110 group-hover:rotate-3 transition-all duration-300"
							>
								<WifiIcon />
							</div>

							<h4
								class="text-2xl font-bold text-slate-900 mb-3 tracking-tight group-hover:text-emerald-600 transition-colors"
							>
								Online 1-on-1
							</h4>
							<p class="text-slate-500 text-sm leading-relaxed">
								Tetap interaktif dengan metode screen sharing
								tatap muka digital di mana pun dan kapan pun
								kamu berada.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Why Us -->
		<section
			class="py-32 bg-slate-900 text-white overflow-hidden"
			id="kenapa"
		>
			<div class="max-w-7xl mx-auto px-6">
				<div
					class="grid lg:grid-cols-[0.8fr_1.2fr] gap-20 items-center"
				>
					<div class="relative">
						<div
							class="absolute -top-20 -left-20 w-64 h-64 bg-blue-500/20 rounded-full hero-blob"
						>
						</div>
						<h2
							class="text-4xl md:text-5xl font-extrabold mb-12 leading-tight"
						>
							Kenapa Harus <br />Privat di Sini?
						</h2>
						<div class="space-y-10">
							<div class="flex gap-6 items-start">
								<div
									class="w-12 h-12 shrink-0 bg-blue-500/20 text-blue-500 rounded-xl flex items-center justify-center border border-blue-500/30"
								>
									<TargetIcon />
								</div>
								<div>
									<h4 class="text-xl font-bold mb-2">
										100% Fokus 1-on-1
									</h4>
									<p class="text-slate-400 leading-relaxed">
										Tidak ada peserta lain. Mentor hanya
										mendengarkan dan membantumu selama sesi
										berlangsung.
									</p>
								</div>
							</div>
							<div class="flex gap-6 items-start">
								<div
									class="w-12 h-12 shrink-0 bg-blue-500/20 text-blue-500 rounded-xl flex items-center justify-center border border-blue-500/30"
								>
									<PresentationIcon />
								</div>
								<div>
									<h4 class="text-xl font-bold mb-2">
										Materi Custom &amp; Project-Based
									</h4>
									<p class="text-slate-400 leading-relaxed">
										Punya ide aplikasi? Kita belajar sambil
										langsung build idemu dari hari pertama.
									</p>
								</div>
							</div>
							<div class="flex gap-6 items-start">
								<div
									class="w-12 h-12 shrink-0 bg-blue-500/20 text-blue-500 rounded-xl flex items-center justify-center border border-blue-500/30"
								>
									<ShieldUserIcon />
								</div>
								<div>
									<h4 class="text-xl font-bold mb-2">
										Mentor Berpengalaman
									</h4>
									<p class="text-slate-400 leading-relaxed">
										Belajar langsung dari praktisi yang
										sudah bertahun-tahun hands-on di
										bidangnya. Gak cuma teori, tapi langsung
										praktik.
									</p>
								</div>
							</div>
						</div>
					</div>
					<div class="grid grid-cols-2 gap-6 relative">
						<div class="space-y-6">
							<Image
								alt="Learning"
								class="rounded-3xl h-64 w-full object-cover shadow-2xl grayscale hover:grayscale-0 transition-all duration-500"
								src={Img1}
							/>
							<Image
								alt="Mentoring"
								class="rounded-3xl h-80 w-full object-cover shadow-2xl grayscale hover:grayscale-0 transition-all duration-500"
								src={Img2}
							/>
						</div>
						<div class="space-y-6 pt-12">
							<Image
								alt="Tech"
								class="rounded-3xl h-80 w-full object-cover shadow-2xl grayscale hover:grayscale-0 transition-all duration-500"
								src={Img3}
							/>
							<Image
								alt="Hardware"
								class="rounded-3xl h-64 w-full object-cover shadow-2xl grayscale hover:grayscale-0 transition-all duration-500"
								src={Img4}
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="py-24 px-6 overflow-hidden">
			<div
				class="max-w-7xl mx-auto bg-blue-500 rounded-[3rem] p-12 md:p-24 text-center relative overflow-hidden shadow-[0_40px_100px_-20px_rgba(59,130,246,0.3)]"
			>
				<div
					class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full -mr-48 -mt-48 blur-3xl"
				>
				</div>
				<div
					class="absolute bottom-0 left-0 w-96 h-96 bg-blue-900/20 rounded-full -ml-48 -mb-48 blur-3xl"
				>
				</div>
				<div class="relative z-10">
					<h2
						class="text-4xl md:text-6xl font-extrabold text-white mb-8 leading-tight"
					>
						Siap Jadi Developer <br />Andal Tanpa Batas?
					</h2>
					<p
						class="text-xl text-white/80 mb-12 max-w-2xl mx-auto leading-relaxed"
					>
						Mulailah perjalanan belajarmu hari ini dengan kurikulum
						yang dipersonalisasi khusus untuk kamu. Konsultasi
						pertama gratis!
					</p>
					<div class="flex flex-col items-center gap-6">
						<a
							href={waLink}
							target="_blank"
							class="bg-white cursor-pointer text-blue-500 px-12 py-6 rounded-2xl font-bold text-xl shadow-2xl hover:scale-105 active:scale-95 transition-all flex items-center gap-4"
						>
							<MessageSquareMoreIcon /> Hubungi via WhatsApp
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</MainLayout>
